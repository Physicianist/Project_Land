# ── OpenAI ──────────────────���───────────────────���───────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_RECOGNITION_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_OUTPUT_TOKENS=2500

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_OPENAI_RECOGNITION=true
ENABLE_MATHPIX=false
ENABLE_BATCH_AI_GRADING=true
ENABLE_ADVANCED_FORMULA_RECOGNITION=false
ENABLE_TEACHER_REVIEW_REQUIRED=true

# ── Mathpix (optional – get keys at mathpix.com) ────────────────────────────
MATHPIX_APP_ID=
MATHPIX_API_KEY=

# ── File limits ────────────────────────────���─────────────────────────────────
AI_MAX_UPLOAD_MB=10
AI_MAX_PDF_PAGES=15
AI_MAX_BATCH_FILES=20
AI_MAX_FILES_PER_SUBMISSION=20
MAX_STUDENT_DISK_MB=200

# ── Rate limiting ────────────────────────────────────────────────────────────
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=80
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_MAX_RETRY_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=2500

# ── Storage (local | s3) ─────────────────────────────────────────────────────
STORAGE_BACKEND=local

# ── App ──────────────────────────���───────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
